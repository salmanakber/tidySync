{
  "name": "tidysync",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node server/dev.js",
    "build": "turbo build",
    "start": "node server/start.js",
    "lint": "turbo lint",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart tidysync",
    "pm2:stop": "pm2 stop tidysync",
    "pm2:reset": "bash scripts/pm2-reset.sh",
    "db:generate": "npm run generate -w @tidysync/database",
    "db:push": "npm run push -w @tidysync/database",
    "db:migrate": "npm run migrate -w @tidysync/database",
    "db:migrate:deploy": "npm run migrate:deploy -w @tidysync/database",
    "db:seed": "npm run seed -w @tidysync/database"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "npm@10.9.2"
}
