{
  "name": "tidysync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @tidysync/database generate",
    "db:push": "pnpm --filter @tidysync/database push",
    "db:migrate": "pnpm --filter @tidysync/database migrate",
    "db:migrate:deploy": "pnpm --filter @tidysync/database migrate:deploy",
    "db:seed": "pnpm --filter @tidysync/database seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.10.0"
}
